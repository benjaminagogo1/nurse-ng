# Use these values in the hosting provider's environment settings.
# Replace the example domain and supply credentials through secret storage.
NURSE_NG_ENVIRONMENT=production
NURSE_NG_DEBUG=false
NURSE_NG_SESSION_HTTPS_ONLY=true
NURSE_NG_SESSION_SAME_SITE=lax
NURSE_NG_PUBLIC_BASE_URL=https://your-nurse-site.example
NURSE_NG_ALLOWED_HOSTS=your-nurse-site.example
NURSE_NG_REQUIRED_WORKERS=recruitment,reels,notifications
# NURSE_NG_SECRET_KEY=<generate a random value of at least 32 characters>
# PostgreSQL URLs beginning postgres:// or postgresql:// use the bundled psycopg driver.
# NURSE_NG_DATABASE_URL=postgresql://<credentials>@<database-host>:5432/<database>?sslmode=require
# Alternatively, use SQLite on a persistent disk for a single web instance:
# NURSE_NG_DATABASE_URL=sqlite:////var/lib/nurse-ng/nurse_ng.db

# Configure only the IPs/CIDRs of the actual reverse proxy/load balancer.
# Empty trusts no forwarded headers. Wildcards and /0 networks are rejected.
NURSE_NG_TRUSTED_PROXY_IPS=
# The host can supply PORT; the web entry point defaults to 8000.
# PORT=8000

# Mount a persistent disk here; web and workers must share these files.
NURSE_NG_AVATAR_DIR=/var/lib/nurse-ng/avatars
NURSE_NG_COMMUNITY_MEDIA_DIR=/var/lib/nurse-ng/community
NURSE_NG_EVIDENCE_DIR=/var/lib/nurse-ng/evidence
NURSE_NG_BACKUP_DIR=/var/lib/nurse-ng/backups
NURSE_NG_COMMUNITY_MALWARE_SCAN_MODE=required
NURSE_NG_EVIDENCE_SCAN_COMMAND=clamscan
# Keep ClamAV signatures current before enabling uploads.

# In-app notifications work without SMTP. Enable mail with a verified sender.
NURSE_NG_ACCOUNT_MAIL_BACKEND=disabled
# NURSE_NG_ACCOUNT_MAIL_BACKEND=smtp
# NURSE_NG_SMTP_HOST=<provider-host>
# NURSE_NG_SMTP_PORT=587
# NURSE_NG_SMTP_SECURITY=starttls
# NURSE_NG_SMTP_FROM=<verified sender name and address>
# NURSE_NG_SMTP_USERNAME=<secret>
# NURSE_NG_SMTP_PASSWORD=<secret>

# Optional Google/LinkedIn credentials use this same public site for callbacks.
# NURSE_NG_GOOGLE_CLIENT_ID=<provider value>
# NURSE_NG_GOOGLE_CLIENT_SECRET=<secret>
# NURSE_NG_LINKEDIN_CLIENT_ID=<provider value>
# NURSE_NG_LINKEDIN_CLIENT_SECRET=<secret>
# Optional native distribution:
# NURSE_NG_ANDROID_APP_DOWNLOAD_URL=https://<published APK or store URL>
# NURSE_NG_IOS_APP_DOWNLOAD_URL=https://<App Store or TestFlight URL>
