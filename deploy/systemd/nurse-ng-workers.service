[Unit]
Description=Nurse.ng background worker supervisor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/nurse-ng
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/nurse-ng/venv/bin/python -m app.cli workers
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
