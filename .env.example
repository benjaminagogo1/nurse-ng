NURSE_NG_ENVIRONMENT=development
NURSE_NG_DEBUG=1
# No shared development key. If omitted, a random per-process key is generated.
# Local sessions end on restart unless you configure your own random key.
NURSE_NG_SESSION_HTTPS_ONLY=0
NURSE_NG_DATABASE_URL=sqlite:///./nurse_ng.db
NURSE_NG_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Document-review evidence is private and must not sit under a static directory.
# NURSE_NG_EVIDENCE_DIR=evidence
# NURSE_NG_EVIDENCE_MAX_BYTES=5242880

# Account photos are stored outside static files and checked on every read.
# NURSE_NG_AVATAR_DIR=media/avatars
# NURSE_NG_AVATAR_MAX_BYTES=5242880

# Email verification and password recovery. SMTP uses certificate-verified TLS.
# NURSE_NG_PUBLIC_BASE_URL=https://nurse.ng
# NURSE_NG_ACCOUNT_MAIL_BACKEND=smtp
# NURSE_NG_SMTP_HOST=
# NURSE_NG_SMTP_PORT=587
# NURSE_NG_SMTP_SECURITY=starttls
# NURSE_NG_SMTP_USERNAME=
# NURSE_NG_SMTP_PASSWORD=
# Set the exact sender name/address verified in your email provider account.
# NURSE_NG_SMTP_FROM=
# Development only: "file" saves private .eml files instead of sending emails.
# NURSE_NG_ACCOUNT_MAIL_BACKEND=file
# NURSE_NG_ACCOUNT_MAIL_DIR=private-mail

# Public community media is separate from private review evidence.
# NURSE_NG_COMMUNITY_MEDIA_DIR=media/community
# NURSE_NG_COMMUNITY_IMAGE_MAX_BYTES=10485760
# NURSE_NG_COMMUNITY_VIDEO_MAX_BYTES=104857600
# NURSE_NG_COMMUNITY_VIDEO_MAX_SECONDS=180
# NURSE_NG_COMMUNITY_POST_LIMIT=10
# NURSE_NG_COMMUNITY_REPLY_LIMIT=60
# NURSE_NG_COMMUNITY_REPORT_LIMIT=20
# NURSE_NG_COMMUNITY_UPLOAD_WINDOW_BYTES=524288000
# NURSE_NG_COMMUNITY_STORAGE_QUOTA_BYTES=5368709120
# disabled, optional, or required. Optional permits an upload if ClamAV cannot run.
# NURSE_NG_COMMUNITY_MALWARE_SCAN_MODE=optional
# NURSE_NG_COMMUNITY_MALWARE_SCAN_COMMAND=clamscan

# Production: replace the development values above; never deploy them as-is.
# NURSE_NG_ENVIRONMENT=production
# NURSE_NG_DEBUG=0
# NURSE_NG_SESSION_HTTPS_ONLY=1
# NURSE_NG_ALLOWED_HOSTS=nurse.ng,www.nurse.ng
# Supply NURSE_NG_SECRET_KEY securely: a random value of at least 32 characters.
# Share the same key across workers; changing it invalidates all existing sessions.
# Hosts are exact DNS names or IPs, without schemes, ports, paths, or wildcards.
# Use a managed PostgreSQL URL, e.g.
# NURSE_NG_DATABASE_URL=postgresql+psycopg://user:password@host:5432/nurse_ng

# Recruitment-source discovery: ROR needs no search credentials.
# Brave stays disabled without BOTH a key and a reference to storage permission.
# NURSE_NG_RECRUITMENT_SEARCH_KEY=
# NURSE_NG_RECRUITMENT_SEARCH_PERMISSION_REFERENCE=
# NURSE_NG_RECRUITMENT_DAILY_TASK_LIMIT=100
# NURSE_NG_RECRUITMENT_PENDING_TASK_LIMIT=500
